# Copy to `.env` and edit. docker compose reads it automatically; `.env` is gitignored,
# so a real token never reaches the repo.
#
#     cp .env.example .env

# ----------------------------------------------------------------- which model
# openai     anything speaking the OpenAI chat-completions API:
#            LM Studio, Ollama, vLLM, llama.cpp, or a hosted endpoint
# anthropic  the Claude API (needs ANTHROPIC_API_KEY)
DI_BACKEND=openai

# ----------------------------------------------------------------- openai-compatible
# A remote endpoint, or a local server. For LM Studio running on this machine use
# http://host.docker.internal:1234/v1 -- inside the container, "localhost" is the
# container itself, not your desktop.
DI_BASE_URL=https://ai.ramonecung.com/v1

# Must be a model the endpoint actually serves. Leave it unset and the extractor
# lists what is available instead of guessing.
DI_MODEL=qwen3.8-27b-uncensored-mlx

# Sent as `Authorization: Bearer ...`. Local servers ignore it; a proxied endpoint
# will not. If yours uses HTTP Basic auth instead, set DI_BASIC_AUTH=user:pass and
# leave this blank.
DI_API_KEY=
DI_BASIC_AUTH=

# ----------------------------------------------------------------- claude api
# Only read when DI_BACKEND=anthropic.
ANTHROPIC_API_KEY=
DI_EFFORT=high

# ----------------------------------------------------------------- limits
# Reasoning models spend this budget thinking before they answer. Too low and the
# response comes back empty with nothing to show for it, which looks like the model
# ignoring the schema. 8000 is comfortable for a page of invoice.
DI_MAX_TOKENS=10000

# Seconds. A 27B model on consumer hardware is not fast; this is not the API.
DI_TIMEOUT=600

# Turn off chain-of-thought. Extraction is transcription -- the fields are printed on
# the page -- so thinking tokens are latency spent on a task that does not need them,
# and they give the model room to "correct" a document the prompt says to copy
# verbatim. Measured both ways before choosing a default.
DI_NO_THINK=

# How JSON is obtained. auto starts with server-side json_schema and falls back to
# carrying the schema in the prompt if the endpoint accepts the parameter but returns
# nothing, which is what a missing constrained-decoding implementation looks like.
#   auto | schema | prompt
DI_JSON_MODE=auto
