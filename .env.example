# Secrets and one-off overrides only. Which plugin runs, and how it is configured,
# both live in di.toml -- so there is one place to look, not two.

# --------------------------------------------------------------------- secrets
DI_OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------- per-plugin one-off overrides
# Namespaced, so a setting can never be aimed at the wrong plugin by accident.
# Anything set here beats di.toml for this run.
DI_EXTRACTOR=
DI_OPENAI_MODEL=
DI_OPENAI_NO_THINK=
DI_ANTHROPIC_MODEL=
